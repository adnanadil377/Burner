APP_NAME=Burner
# Database connection string (PostgreSQL with Supabase)
# Format: postgresql+psycopg2://{USER}:{PASSWORD}@{HOST}:{PORT}/{DBNAME}?sslmode=require
DATABASE_URL=postgresql+psycopg2://{USER}:{PASSWORD}@{HOST}:{PORT}/{DBNAME}?sslmode=require
ALGORITHM=HS256
SECRET_KEY=your-super-secret-key
REFRESH_KEY=your-super-secret-refresh-key

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=from_cloudflare_accountid
R2_ACCESS_KEY=from_cloudflare_accesskey
R2_SECRET_KEY=from_cloudflare_secretkey
# Name of your Cloudflare R2 bucket (default: "burner-video" if unset)
R2_BUCKET_NAME=your-bucket-name

# Redis Configuration
# Full connection string for the Redis instance used by this application.
# Example: redis://user:password@localhost:6379/0
# Used for caching, background jobs, and rate limiting where applicable.
REDIS_URL=redis://localhost:6379/0

# Gemini API Configuration
# API key for the Gemini model provider.
# Obtain this from your Gemini account dashboard and keep it secret.
# Required for any AI-powered or generative features within the app.
GEMINI_API_KEY=your-gemini-api-key
# Gemini model to use for transcription (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-3-flash-preview

# Email / SMTP Configuration
# Email address used by the application to send transactional emails
# (e.g., verification links, password resets, notifications).
# Prefer a dedicated no-reply or system account managed by your email provider.
EMAIL_ADDRESS=email@gmail.com

# Password or app-specific SMTP credential for the above email account.
# Never commit real credentials to version control; use a secure secret store
# or environment injection in production.
EMAIL_PASSWORD=app password

# SMTP server hostname provided by your email service.
# Example (Gmail): smtp.gmail.com
SMTP_SERVER=smtp.gmail.com

# SMTP port corresponding to your email provider and security mode.
# Common values: 465 (SSL), 587 (TLS), 25 (plain/legacy).
SMTP_PORT=465

# Base URL of the frontend application used to generate absolute links
# in emails and redirects (e.g., for verification or password reset flows).
# In production, set this to your public frontend URL.
FRONTEND_URI=http://localhost:5173

# Set to True in production with HTTPS to enable secure cookie flag for refresh tokens
COOKIE_SECURE=False